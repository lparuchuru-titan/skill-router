{
  "version": 1,
  "note": "The server does not use this file to choose skills. It loads every skill whose own job phrase appears in the prompt. `when` exists so eval/compare.mjs can measure a phrase list against the same prompts. Earlier rules win ties in that scorer, so specific phrases come first. `also` is unused.",
  "rules": [
    {
      "id": "apex-test-run",
      "skill": "platform-apex-test-run",
      "when": ["code coverage", "run apex test", "failing test class"],
      "also": [],
      "why": "Running tests is not the same skill as writing them."
    },
    {
      "id": "apex-test-generate",
      "skill": "platform-apex-test-generate",
      "when": ["apex test class", "apex test", "bulk test"],
      "also": [],
      "why": "A new Apex test class."
    },
    {
      "id": "apex-logs",
      "skill": "platform-apex-logs-debug",
      "when": ["debug log", "governor limit", "cpu time"],
      "also": [],
      "why": "A log or a limit failure."
    },
    {
      "id": "apex-generate",
      "skill": "platform-apex-generate",
      "when": ["apex class", "apex trigger", "refactor apex"],
      "also": [],
      "why": "Production Apex, not tests."
    },
    {
      "id": "soql",
      "skill": "platform-soql-query",
      "when": ["soql", "sosl"],
      "also": [],
      "why": "A Salesforce query."
    },
    {
      "id": "retrieve",
      "skill": "platform-metadata-retrieve",
      "when": ["sf project retrieve", "retrieve metadata"],
      "also": [],
      "why": "Pull metadata from an org."
    },
    {
      "id": "deploy",
      "skill": "platform-metadata-deploy",
      "when": ["sf project deploy", "deploy metadata"],
      "also": [],
      "why": "Push metadata to an org."
    },
    {
      "id": "custom-field",
      "skill": "platform-custom-field-generate",
      "when": ["formula field", "custom field", "roll-up summary"],
      "also": [],
      "why": "A field. Access is a separate skill and loads only when the prompt asks for it."
    },
    {
      "id": "permission-set",
      "skill": "platform-permission-set-generate",
      "when": ["permission set", "field-level security", "fls"],
      "also": [],
      "why": "Grant access. Do not create the field here."
    },
    {
      "id": "validation-rule",
      "skill": "platform-validation-rule-generate",
      "when": ["validation rule", "error condition formula"],
      "also": [],
      "why": "A validation rule."
    },
    {
      "id": "flow",
      "skill": "automation-flow-generate",
      "when": ["screen flow", "record-triggered flow", "autolaunched flow"],
      "also": [],
      "why": "A Flow."
    },
    {
      "id": "code-analyzer",
      "skill": "dx-code-analyzer-run",
      "when": ["code analyzer", "pmd"],
      "also": [],
      "why": "A static scan."
    },
    {
      "id": "unit-tests",
      "skill": "write-unit-tests",
      "when": ["jest", "pytest"],
      "also": [],
      "why": "A non-Apex unit test."
    },
    {
      "id": "review-a-change",
      "skill": "review-pull-request",
      "when": ["pull request", "code review"],
      "also": [],
      "why": "A review. A unit test loads only when the prompt also asks for one."
    },
    {
      "id": "explain",
      "skill": "explain-code",
      "when": ["walk me through", "new hire"],
      "also": [],
      "why": "An onboarding explanation."
    },
    {
      "id": "docs",
      "skill": "draft-docs",
      "when": ["readme"],
      "also": [],
      "why": "Human-facing docs."
    },
    {
      "id": "sql",
      "skill": "query-data",
      "when": ["postgres", "sql query"],
      "also": [],
      "why": "A relational SQL query, not SOQL."
    },
    {
      "id": "ship-a-release",
      "skill": "ship-release",
      "when": ["changelog", "release checklist"],
      "also": [],
      "why": "A release. Docs load only when the prompt also asks for them."
    },
    {
      "id": "http",
      "skill": "http-api-guide",
      "when": ["status code", "pagination", "idempotency"],
      "also": [],
      "why": "An HTTP API design question."
    }
  ]
}
